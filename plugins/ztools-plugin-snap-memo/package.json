{
  "name": "snap-memo",
  "version": "0.4.0",
  "description": "ZTools 速贴备忘：毫秒级检索备忘与常用片段，回车直接粘贴到当前应用",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "overlayscrollbars": "^2.17.0",
    "pinyin-pro": "^3.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
